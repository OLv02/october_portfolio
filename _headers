# Response headers for Cloudflare Pages. tools/serve.py applies the same rules locally.

/*
  ! Access-Control-Allow-Origin
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# The main page runs only its own scripts and system fonts; the latest posts come from the blog's RSS feed.
# GitHub Pages ignores this file (it's Cloudflare Pages' format); tools/serve.py applies it locally, so the policy is still tested.
/
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'sha256-V4ZNUDDEOn9X2UKW/PALR43cPeTFfs9dghsKy/8IuJo='; font-src 'self'; img-src 'self' data:; connect-src 'self' https://olv02.github.io; media-src 'self' data:; worker-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'
/index.html
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'sha256-V4ZNUDDEOn9X2UKW/PALR43cPeTFfs9dghsKy/8IuJo='; font-src 'self'; img-src 'self' data:; connect-src 'self' https://olv02.github.io; media-src 'self' data:; worker-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'

/js/vendor/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/assets/img/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
